# Copy to frontend/.env.local (ignored by git).

NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps Platform browser key for the live-traffic map layer (Map Tiles API).
# It ships to the browser, so restrict it: HTTP referrers = your site
# (http://localhost:3000/*, https://<your-domain>/*) and API = Map Tiles API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
