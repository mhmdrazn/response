# Copy to frontend/.env.local (ignored by git).

NEXT_PUBLIC_API_URL=http://localhost:8000

# TomTom key for the live-traffic map layer. Server-only (no NEXT_PUBLIC_ prefix):
# the browser loads tiles through /api/traffic-tiles, which adds the key.
TOMTOM_API_KEY=
# Caps on upstream tile calls (defaults: 90 % of the 200k/month free tier).
# TOMTOM_MONTHLY_TILE_LIMIT=180000
# TOMTOM_DAILY_TILE_LIMIT=5806
