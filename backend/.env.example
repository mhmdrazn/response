# Copy to backend/.env (ignored by git). Real environment variables override this file.

# Google Maps Platform key for live traffic in route planning (Routes API,
# computeRouteMatrix with TRAFFIC_AWARE). Server-side only: restrict it to the
# Routes API (and to your server's IP where possible). Leave empty to plan on
# the precomputed OSRM travel times.
GOOGLE_MAPS_API_KEY=

# Matrix elements bought per traffic refresh (each billed by Google).
TRAFFIC_MAX_ELEMENTS=400
# Seconds a traffic snapshot is reused before Google is asked again.
TRAFFIC_CACHE_TTL_S=600
