# Copy to backend/.env (ignored by git). Real environment variables override this file.

# TomTom key for live traffic when planning on the blank canvas (Kanvas Baru).
# Uses the Traffic Flow Segment Data API, so the same key as the map's traffic
# layer works. Server-side only. Leave empty to plan on the precomputed OSRM
# travel times. The study areas always use the OSRM times.
TOMTOM_API_KEY=

# Road points (one request each) asked about per traffic refresh.
TRAFFIC_MAX_POINTS=60
# Seconds a traffic snapshot is reused before TomTom is asked again.
TRAFFIC_CACHE_TTL_S=600
# Requests per day across all refreshes (free tier: 20,000 a month).
TOMTOM_FLOW_DAILY_LIMIT=580
